# Settings for docker-compose.stack.yml. Copy to .env and fill in; .env is git-ignored. Never commit real values.
# Ask the DevOps member for the passwords and the signing key; share them privately.

# ── Databases (remote MySQL server wonrichmysql, one scoped user per service) ──
# Each is: Server=wonrichmysql.mysql.database.azure.com;Port=3306;Database=<db>;User=<user>;Password=<password>;SslMode=Required;
AUTH_DB_CONNECTION=
MCC_DB_CONNECTION=
PROCESSING_DB_CONNECTION=
QLS_DB_CONNECTION=
TRC_DB_CONNECTION=
# Optional: a read-only login on Processing's database for Quality Lab's processing sync.
QLS_PROCESSING_DB_CONNECTION=

# ── Auth: the signing key must be the same for every service ──
AUTH_SIGNING_KEY=

# ── Kafka: the local broker started by this stack. Defaults need no changes. ──
# Staging instead:
#   KAFKA_BOOTSTRAP_SERVERS=wonrich-kafka.southeastasia.cloudapp.azure.com:9094
#   KAFKA_SECURITY_PROTOCOL=SaslPlaintext
#   KAFKA_SASL_MECHANISM=Plain
#   KAFKA_SASL_USERNAME=wonrich
#   KAFKA_SASL_PASSWORD=<password>
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_SECURITY_PROTOCOL=Plaintext
KAFKA_SASL_MECHANISM=
KAFKA_SASL_USERNAME=
KAFKA_SASL_PASSWORD=

# ── Frontend ──
FRONTEND_ORIGIN=http://localhost:5173

# ── Grafana ──
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=CHANGE_ME_LOCAL_ONLY
